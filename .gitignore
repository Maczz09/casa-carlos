node_modules/
dist/
build/
*.log
.env
.env.local
data/*.db
data/*.db-shm
data/*.db-wal
data/whatsapp-session/
# Secreto local que comparten el servidor y el agente de WhatsApp — lo genera
# el servidor solo, es distinto en cada instalación, nunca se versiona.
data/whatsapp-agent.token
data/backups/
data/product-images/
# Marca del hotel (logo + nombre) y fotos de los QR de las billeteras: son
# contenido del cliente, cargado desde el instalador o desde Ajustes.
data/brand/
data/brand-images/
data/qr-images/
*.pfx
*.p12
.turbo/
*.tsbuildinfo
vendor/
# Generado por node-windows/winsw al instalar el servicio (scripts/service/install-service.cjs) —
# binario + config con rutas absolutas de esta máquina, se regenera en cada instalación.
apps/server/src/daemon/
# El .exe compilado del instalador — se regenera con ISCC, no hace falta versionarlo.
installer/output/
# Salidas de compilación de Tauri (se regeneran con `pnpm run
# desktop:publish` antes de compilar el instalador).
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/bin/
apps/desktop/obj/
apps/desktop/generated/
apps/desktop/publish/
