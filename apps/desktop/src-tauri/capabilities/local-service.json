{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-service",
  "description": "Permite que el servicio local de Hospedaje Carlos guarde exportaciones solicitadas por Recepción.",
  "windows": ["main"],
    "permissions": ["core:default", "notification:default", "allow-save-export-file"],
  "remote": {
    "urls": ["http://127.0.0.1:4000/*", "http://localhost:4000/*"]
  }
}
