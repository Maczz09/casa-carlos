<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HospedajeCarlos</AssemblyName>
    <RootNamespace>HospedajeCarlos.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon Condition="Exists('generated\HospedajeCarlos.ico')">generated\HospedajeCarlos.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Hospedaje Carlos</Authors>
    <Company>Hospedaje Carlos</Company>
    <Product>Hospedaje Carlos</Product>
    <Description>Aplicación de escritorio para recepción y kiosco de Hospedaje Carlos.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <!-- El paquete agrega también su control WPF aunque este proyecto sea solo
       WinForms. Se retira después de que NuGet importe sus targets para no
       empaquetar una dependencia innecesaria ni mezclar WindowsBase 4/5. -->
  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
